  object qy_Cash2Client: TEDBQuery
    ReadOnly = True
    DatabaseName = 'PGC_DB_Unicode'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      
        'SELECT Data, DataPayedOut,Clients.ID, Clients.Alias, Clients.Las' +
        'tName, Clients.FirstName, Dare,Closed, TxID'
      
        'FROM Clients INNER JOIN clCCLedger On Clients.id = clCCLedger.Cl' +
        'ientID'
      
        'WHERE Dare > 0 AND clCCLedger.Data BETWEEN CAST('#39'2023-10-01 12:0' +
        '0:00'#39' AS Timestamp)'
      ' AND CAST('#39'2023-11-01 11:59:00'#39' as Timestamp)'
      ' ORDER BY  Data')
