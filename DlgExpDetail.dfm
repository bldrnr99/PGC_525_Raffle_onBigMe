    BorderStyle = bsNone
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWhite
    Font.Height = -13
    Font.Name = 'Tahoma'
    Font.Style = []
    Lines.Strings = (
      
        'Con REGISTRAZION CON RICEVUTA si intende unicamente ricevute car' +
        'tacee ricevute da terzi o '
      
        'rilasciate da noi  (per esemp.: ns ricevute per cauzioni camere,' +
        ' ecc). '
      
        'Non sono assolutamente da considerare come ricevute gli scontrin' +
        'i delle carte di credito. ')
