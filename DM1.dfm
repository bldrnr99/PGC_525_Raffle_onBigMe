  object qy_FR_Teseu1: TEDBQuery
    ReadOnly = True
    DatabaseName = 'DB_Main'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      'SELECT Clients.IDTeseu, CH.ClientID,'
      'CH.dateInteseu, CH.DateOutTeseu dOutT,'
      'CH.arrivaldate,CH.departuredate,('
      
        '(IF(CH.DateOutTeseu > cast('#39'2020-01-31'#39' AS Date),cast('#39'2020-01-3' +
        '1'#39' AS Date),cast(CH.DateOutTeseu as Date))-'
      
        '(IF(CH.DateInTeseu < cast('#39'2020-01-01'#39' AS Date),cast('#39'2020-01-01' +
        #39' AS Date),cast(CH.DateInTeseu as Date))))'
      ')Day + 1 as TotWork,'
      
        '(((IF(CH.DateOutTeseu > cast('#39'2020-01-31'#39' AS Date),cast('#39'2020-01' +
        '-31'#39' AS Date),cast(CH.DateOutTeseu as Date))-'
      
        '(IF(CH.DateInTeseu < cast('#39'2020-01-01'#39' AS Date),cast('#39'2020-01-01' +
        #39' AS Date),cast(CH.DateInTeseu as Date))))'
      ')Day + 1)*25 as TotTax'
      'FROM Clients'
      'LEFT  JOIN ClientHistory CH'
      'ON Clients.ID= ClientHistory.ClientID'
      'where not ClientHistory.dateInteseu is null and '
      
        '(CH.DateInTeseu Between  cast('#39'2020-01-01'#39' AS Date) and cast('#39'20' +
        '20-01-31'#39' AS Date)) or'
      
        '(CH.DateOutTeseu Between  cast('#39'2020-01-01'#39' AS Date) and cast('#39'2' +
        '020-01-31'#39' AS Date))'
      'ORDER BY Clients.Alias')
    Params = <>
    Left = 906
    Top = 584
  end
