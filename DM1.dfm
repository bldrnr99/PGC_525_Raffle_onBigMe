  object qy_BarOpLedger: TEDBQuery
    ReadOnly = True
    DatabaseName = 'DB_Bar'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      
        'SELECT Data, ProductName, Dare, Avere,PayMethod, bS.SoldBy,c.Ali' +
        'as,  txid, Waiter FROM Bar_OpLedger bO'
      'Left Join PGC_Bar.Bar_Products bP ON bO.ProductID = bP.ProductID'
      'LEFT JOIN PGC_Bar.Bar_SoldByDetail bS ON bS.TxID = bO.TxID'
      'LEFT JOIN PGC_DB_Main_Euro.Clients c ON c.ID = bS.SoldBy'
      
        'WHERE Data BETWEEN CAST('#39'2025-08-31 12:00:00'#39' AS TIMESTAMP) AND ' +
