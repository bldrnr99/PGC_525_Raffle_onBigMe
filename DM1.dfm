  object qy_1000_GCC: TEDBQuery
    Active = True
    ReadOnly = True
    DatabaseName = 'DB_Main'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      '-- Period window'
      '-- Replace these literals with your actual bounds if needed'
      '-- Start = 2025-09-01 12:00:00, End = 2025-10-01 11:59:59'
      ''
      '-- Detail rows (movement in period)'
      'SELECT'
      '  c.ClientID,'
      '  cl.Alias,'
      '  c.Data,'
      '  c.Dare,'
      '  c.Avere,'
      '  c.SubFeeID,'
      '  CAST(NULL AS DECIMAL(18,2)) AS Balance,'
      '  CAST('#39#39' AS VARCHAR(20))     AS Note,'
      '  CAST(0 AS SMALLINT)         AS RowType,           -- detail'
      '  c.TxID'
      'FROM c_2900 c'
      'LEFT JOIN clients cl ON cl.ID = c.ClientID'
      'WHERE c.SubFeeID IN (289, 299, 999, 990)'
      '  AND c.Data BETWEEN CAST('#39'2024-09-01 12:00:00'#39' AS TIMESTAMP)'
      '                  AND CAST('#39'2025-10-01 11:59:59'#39' AS TIMESTAMP)'
      ''
      'UNION ALL'
      ''
      
        '-- One balance row per client: opening(before start) + movement(' +
        'in period)'
      'SELECT'
      '  ids.ClientID,'
      '  CAST('#39'Saldo '#39' + cl.Alias AS VARCHAR(50)) AS Alias,'
      '  CAST(NULL AS DATE)          AS Data,'
      '  CAST(NULL AS DECIMAL(18,2)) AS Dare,'
      '  CAST(NULL AS DECIMAL(18,2)) AS Avere,'
      
        '  CAST(NULL AS INTEGER)       AS SubFeeID,         -- avoid per-' +
        'SubFeeID duplicates'
      '  CAST('
      '    ( COALESCE(o.Opening, 0) + COALESCE(m.Movement, 0) )'
      '    AS DECIMAL(18,2)'
      '  )                           AS Balance,'
      '  CAST('#39'Saldo Cliente'#39' AS VARCHAR(20)) AS Note,'
      '  CAST(1 AS SMALLINT)         AS RowType,          -- balance'
      
        '  CAST(NULL AS VARCHAR(50))   AS TxID              -- adjust len' +
        'gth to your real TxID size'
      'FROM'
      '  ( SELECT DISTINCT ClientID'
      '    FROM c_2900'
      '    WHERE SubFeeID IN (289, 299, 999, 990)'
      '      AND Data BETWEEN CAST('#39'2025-09-01 12:00:00'#39' AS TIMESTAMP)'
      '                  AND CAST('#39'2025-10-01 11:59:59'#39' AS TIMESTAMP)'
      '  ) ids'
      'LEFT JOIN clients cl ON cl.ID = ids.ClientID'
      'LEFT JOIN ('
      '  SELECT ClientID,'
      '         SUM(COALESCE(Dare,0) - COALESCE(Avere,0)) AS Opening'
      '  FROM c_2900'
      '  WHERE SubFeeID IN (289, 299, 999, 990)'
      '    AND Data < CAST('#39'2025-09-01 12:00:00'#39' AS TIMESTAMP)'
      '  GROUP BY ClientID'
      ') o ON o.ClientID = ids.ClientID'
      'LEFT JOIN ('
      '  SELECT ClientID,Paymethod,'
      '         SUM(COALESCE(Dare,0) - COALESCE(Avere,0)) AS Movement'
      '  FROM c_2900'
      '  WHERE SubFeeID IN (289, 299, 999, 990)'
      '    AND Data BETWEEN CAST('#39'2025-09-01 12:00:00'#39' AS TIMESTAMP)'
      '                 AND CAST('#39'2025-10-01 11:59:59'#39' AS TIMESTAMP)'
      '  GROUP BY ClientID'
      ') m ON m.ClientID = ids.ClientID'
      ''
      'ORDER BY'
      '  ClientID,'
      '  RowType,'
      '  COALESCE(Data, CAST('#39'9999-12-31'#39' AS DATE));')
    Params = <>
    Left = 552
    Top = 312
    object qy_1000_GCCClientID: TIntegerField
      FieldName = 'ClientID'
      Origin = 'c_2900.ClientID'
    end
    object qy_1000_GCCAlias: TWideStringField
      FieldName = 'Alias'
      Origin = 'clients.Alias'
      Size = 50
    end
    object qy_1000_GCCData: TDateTimeField
      FieldName = 'Data'
      Origin = 'c_2900.Data'
    end
    object qy_1000_GCCDare: TFloatField
      FieldName = 'Dare'
      Origin = 'c_2900.Dare'
    end
    object qy_1000_GCCAvere: TFloatField
      FieldName = 'Avere'
      Origin = 'c_2900.Avere'
    end
    object qy_1000_GCCSubFeeID: TIntegerField
      FieldName = 'SubFeeID'
      Origin = 'c_2900.SubFeeID'
    end
    object qy_1000_GCCBalance: TBCDField
      FieldName = 'Balance'
      Size = 2
    end
    object qy_1000_GCCNote: TWideStringField
      FieldName = 'Note'
    end
    object qy_1000_GCCRowType: TSmallintField
      FieldName = 'RowType'
    end
    object qy_1000_GCCTxID: TWideStringField
      FieldName = 'TxID'
      Origin = 'c_2900.TxID'
      Size = 50
    end
  end
