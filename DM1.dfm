  object q: TEDBQuery
    ReadOnly = True
    DatabaseName = 'DB_Main'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      'SELECT'
      '  c.ID AS ClientID,'
      '  c.Alias,'
      ''
      
        '  /* Days 1..7 + W1 (only FeeIDs 4/5/6 in daily+weekly buckets) ' +
        '*/'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) =  1' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d01,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) =  2' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d02,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) =  3' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d03,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) =  4' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d04,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) =  5' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d05,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) =  6' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d06,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) =  7' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d07,'
      
        '  /*SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) BE' +
        'TWEEN 1 AND 7  AND t.FeeID IN (4,5,6) THEN 1 END) AS W1,*/'
      ''
      '  /* Days 8..14 + W2 */'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) =  8' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d08,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) =  9' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d09,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 10' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d10,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 11' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d11,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 12' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d12,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 13' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d13,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 14' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d14,'
      
        '  /*SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) BE' +
        'TWEEN 8 AND 14 AND t.FeeID IN (4,5,6) THEN 1 END) AS W2,*/'
      ''
      '  /* Days 15..21 + W3 */'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 15' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d15,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 16' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d16,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 17' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d17,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 18' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d18,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 19' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d19,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 20' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d20,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 21' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d21,'
      
        '  /*SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) BE' +
        'TWEEN 15 AND 21 AND t.FeeID IN (4,5,6) THEN 1 END) AS W3,*/'
      ''
      '  /* Days 22..28 + W4 */'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 22' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d22,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 23' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d23,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 24' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d24,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 25' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d25,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 26' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d26,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 27' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d27,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 28' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d28,'
      
        '  /*SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) BE' +
        'TWEEN 22 AND 28 AND t.FeeID IN (4,5,6) THEN 1 END) AS W4,*/'
      ''
      '  /* Days 29..31 + W5 */'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 29' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d29,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 30' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d30,'
      
        '  SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) = 31' +
        ' AND t.FeeID IN (4,5,6) THEN 1 END) AS d31,'
      
        '  /*SUM(CASE WHEN EXTRACT(DAY FROM CAST(t.ClosingID AS DATE)) >=' +
        ' 29 AND t.FeeID IN (4,5,6) THEN 1 END) AS W5,*/'
      ''
      '  /* Per-alias totals for 4/5/6 and FeeID=3 only at right end */'
      '  SUM(CASE WHEN t.FeeID = 4 THEN 1 END) AS Total_Fee4,'
      '  SUM(CASE WHEN t.FeeID = 5 THEN 1 END) AS Total_Fee5,'
      '  SUM(CASE WHEN t.FeeID = 6 THEN 1 END) AS Total_Fee6,'
      '  SUM(CASE WHEN t.FeeID = 3 THEN 1 END) AS Total_Fee3,'
      ''
      '  /* FeeID=1 daily totals (only show on ClientID=0 row) */'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) =  1 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d01,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) =  2 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d02,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) =  3 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d03,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) =  4 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d04,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) =  5 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d05,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) =  6 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d06,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) =  7 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d07,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) =  8 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d08,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) =  9 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d09,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 10 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d10,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 11 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d11,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 12 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d12,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 13 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d13,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 14 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d14,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 15 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d15,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 16 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d16,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 17 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d17,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 18 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d18,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 19 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d19,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 20 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d20,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 21 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d21,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 22 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d22,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 23 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d23,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 24 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d24,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 25 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d25,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 26 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d26,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 27 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d27,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 28 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d28,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 29 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d29,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 30 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d30,'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 AND EXTRACT(' +
        'DAY FROM CAST(t.ClosingID AS DATE)) = 31 THEN 1 END) ELSE NULL E' +
        'ND AS F1_d31,'
      ''
      '  /* FeeID=1 monthly total only on ClientID=0 row */'
      
        '  CASE WHEN c.ID = 0 THEN SUM(CASE WHEN t.FeeID = 1 THEN 1 END) ' +
        'ELSE NULL END AS Total_Fee1'
      ''
      'FROM c_1000 t'
      'JOIN Clients c ON c.ID = t.ClientID'
      'WHERE  t.FeeID IN (1,3,4,5,6)'
      'AND t.ClosingID >= '#39'2025-08-01'#39'  AND'
      ' t.ClosingID < '#39'2025-09-01'#39
      'GROUP BY c.ID, c.Alias'
      'ORDER BY c.Alias;')
    Params = <>
    Left = 24
    Top = 144
  end
