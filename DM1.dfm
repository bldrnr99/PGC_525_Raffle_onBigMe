  object qy_gPec: TEDBQuery
    ReadOnly = True
    DatabaseName = 'DB_Main'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      'Select'
      '      t1.ID,'
      '      t1.Alias,'
      '      COALESCE(t3.Salite,0) AS salite,'
      '      COALESCE(t2.CC,0) AS CC,'
      '      COALESCE(t2.CountCC,0) AS CountCC,'
      
        '      (COALESCE(t3.Salite,0) - COALESCE(t2.CountCC,0))*120 As Ca' +
        'sh,'
      
        '      COALESCE(t2.CC,0) + (COALESCE(t3.Salite,0) - COALESCE(t2.C' +
        'ountCC,0))*120 AS Total,'
      '      COALESCE(t4.Girl,0) AS Girl,'
      '      COALESCE(t5.Clients,0) AS Clients,'
      '      COALESCE(t4.Girl + t5.Clients,0) AS ClubTotal,'
      '      COALESCE(t6.Presenze,0) AS Presenze,'
      '      COALESCE((t4.Girl+t5.Clients)/t6.Presenze,0) AS Media'
      '   FROM '
      '      Clients AS t1'
      
        'LEFT JOIN ( select CO.Data, CO.FeeID, CO.ClientID, COALESCE(COUN' +
        'T(FeeID),0) as Presenze'
      '                        from ClLedger CO'
      'WHERE (FeeID = 3)'
      
        'AND Data Between CAST('#39'2022-08-01 12:00:00'#39' AS TimeStamp) AND CA' +
        'ST('#39'2022-08-07 12:00:00'#39' AS TimeStamp)'
      '                        group by CO.ClientID ) AS t6'
      '            on t1.ID = t6.ClientID'
      
        'LEFT JOIN ( select t2.Data, t2.ClientID, COALESCE(SUM(t2.Dare),0' +
        ') as CC, COALESCE(COUNT(t2.Dare),0) As CountCC'
      '                        from ClCCLedger t2'
      
        'WHERE t2.Data Between CAST('#39'2022-08-01 12:00:00'#39' AS TimeStamp) A' +
        'ND CAST('#39'2022-08-07 12:00:00'#39' AS TimeStamp)'
      
        '                        group by t2.ClientID ) t2 ON t6.ClientID' +
        ' = t2.ClientID'
      ''
      
        'LEFT JOIN ( select CO.Data, CO.FeeID, CO.ClientID, COALESCE(SUM(' +
        'Dare),0) as Girl'
      '                        from ClLedger CO'
      'WHERE (FeeID = 3 OR FEEID = 30 OR FeeID = 20)'
      
        'AND Data Between CAST('#39'2022-08-01 12:00:00'#39' AS TimeStamp) AND CA' +
        'ST('#39'2022-08-07 12:00:00'#39' AS TimeStamp)'
      '                        group by CO.ClientID ) AS t4'
      '            on t1.ID = t4.ClientID'
      '        '
      
        '         LEFT JOIN ( select CO.Data, CO.FeeID, CO.ClientID, COAL' +
        'ESCE(Count(FeeID),0) as Salite, COALESCE(Count(FeeID)*120,0) AS ' +
        'Pec'
      '                        from ClLedger CO'
      'WHERE (FeeID = 4 OR FEEID = 5 OR FeeID = 6)'
      
        'AND Data Between CAST('#39'2022-08-01 12:00:00'#39' AS TimeStamp) AND CA' +
        'ST('#39'2022-08-07 12:00:00'#39' AS TimeStamp)'
      '                        group by CO.ClientID ) AS t3'
      '            on t1.ID = t3.ClientID'
      
        'LEFT JOIN ( select CO.Data, CO.FeeID, CO.ClientID, COALESCE(SUM(' +
        'Dare),0) as Clients'
      '                        from ClLedger CO'
      'WHERE (FEEID = 99 OR FeeID = 4 OR FEEID = 5 OR FeeID = 6)'
      
        'AND Data Between CAST('#39'2022-08-01 12:00:00'#39' AS TimeStamp) AND CA' +
        'ST('#39'2022-08-07 12:00:00'#39' AS TimeStamp)'
      '                        group by CO.ClientID ) AS t5'
      '            on t1.ID = t5.ClientID'
      ''
      
        'WHERE Data Between CAST('#39'2022-08-01 12:00:00'#39' AS TimeStamp) AND ' +
        'CAST('#39'2022-08-07 12:00:00'#39' AS TimeStamp)'
      'Order BY t5.Clients DESC')
    Params = <>
    Left = 209
    Top = 493
  end
