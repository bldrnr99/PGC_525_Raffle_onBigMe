  object qy_CashToClients: TEDBQuery
    ReadOnly = True
    DatabaseName = 'DB_Main'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      
        'SELECT Data, Clients.ID, Clients.Alias, Clients.LastName || '#39' '#39' ' +
        '|| Clients.FirstName AS Name, Dare AS Entrata, Avere AS Uscita, ' +
        'txid'
      'FROM Clients INNER JOIN c_1000 On Clients.id = c_1000.ClientID'
      
        ' WHERE Data BETWEEN CAST('#39'2025-09-01 12:00:00'#39' AS TimeStamp) AND' +
        ' CAST('#39'2025-10-01 11:59:59'#39' AS TimeStamp)'
      'AND (SubFeeID = 990 OR SubFeeID = 999)'
      ' ORDER BY Data')
    Params = <>
    Left = 520
    Top = 560
  end
