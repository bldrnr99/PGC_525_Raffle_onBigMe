  object qy_InHousePresence: TEDBQuery
    ReadOnly = True
    DatabaseName = 'DB_Main'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      'SELECT'
      '  c.ID            AS ClientID,'
      '  c.Alias,'
      '  c.Phone,'
      '  ('
      '    SELECT MAX(ss.SoldDT)'
      '    FROM ServicesSold ss'
      '    WHERE ss.ClientID = c.ID'
      '      AND ss.FeeID    = 3'
      '      AND ss.Valid    = FALSE   -- use = 0 if Valid is numeric'
      '  ) AS LastInvalidFee3Date'
      'FROM Clients c'
      'WHERE'
      '  /* has at least one open booking */'
      '  EXISTS ('
      '    SELECT 1'
      '    FROM RREU_Bookings b'
      '    WHERE b.GuestID = c.ID'
      '      AND b.CheckOutDate IS NULL'
      '  )'
      '  AND NOT EXISTS ('
      '    SELECT 1'
      '    FROM ServicesSold ss2'
      '    WHERE ss2.ClientID = c.ID'
      '      AND ss2.FeeID    = 3'
      '      AND ss2.Valid    = TRUE   -- use = 1 if Valid is numeric'
      '  )'
      'ORDER BY c.Alias;')
    Params = <>
    Left = 213
    Top = 264
  end
  object scqy_InHousePresence: TDataSource
    DataSet = qy_InHousePresence
    Left = 320
    Top = 326
  end
