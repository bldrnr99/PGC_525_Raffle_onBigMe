  object qy_TabsOpen: TEDBQuery
    ReadOnly = True
    DatabaseName = 'DB_Bar'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      
        'SELECT Data, PayMethod, Waiter, sum(COALESCE(Avere,0)) - sum(COA' +
        'LESCE(Dare,0))  as Balance,'
      'SUBSTRING(TxID,8)AS tID, TxID,Print, Bar_TabRemarks.Remarks'
      'FROM Bar_OpLedger '
      'Left Join Bar_TabRemarks ON TxID = Bar_TabRemarks.TxID'
      'WHERE (Data BETWEEN CAST('#39'2022-01-01 12:00:00'#39' AS Timestamp)'
      
        'AND CAST('#39'2022-01-02 11:59:00'#39' AS Timestamp)) AND PayMethod = '#39'R' +
        'T'#39
      'GROUP BY TxID'
      'HAVING Balance > 0')
    Params = <>
    Left = 867
    Top = 139
  end
