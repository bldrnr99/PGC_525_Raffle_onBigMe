  object qy_FR_OpLedger: TEDBQuery
    ReadOnly = True
    DatabaseName = 'DB_Main'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      
        'SELECT Data, cast(Cardid as varchar(10))as CardID, Description,D' +
        'are,Avere'
      'FROM OpLedger '
      
        'WHERE OpLedger.Data BETWEEN CAST('#39'2021-07-01 12:00'#39' AS Timestamp' +
        ')'
      'AND CAST('#39'2021-08-01 11:59'#39' as Timestamp)'
      'UNION'
      
        '(SELECT Data,cast(Operator as varchar(10))as CardID,Description,' +
        'Dare,Avere'
      'FROM ExpLedger WHERE Expense = False AND Description IS NOT NULL'
      'AND ExpLedger.Data BETWEEN CAST('#39'2021-07-01 12:00'#39' AS Timestamp)'
      'AND CAST('#39'2021-08-01 11:59'#39' as Timestamp))'
      'Order by Data')
    Params = <>
    Left = 1032
    Top = 637
  end
