  object qy_BarClosing: TEDBQuery
    ReadOnly = True
    DatabaseName = 'DB_Bar'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      'SELECT '
      '    ClosingID,'
      '    Waiter,'
      
        '    SUBSTRING(CAST(CAST(MIN(Data) AS TIME) AS VARCHAR(8)) FROM 1' +
        ' FOR 5) AS FromShift,'
      
        '    SUBSTRING(CAST(CAST(MAX(Data) AS TIME) AS VARCHAR(8)) FROM 1' +
        ' FOR 5) AS ToShift,'
      
        '    COALESCE(SUM(CASE WHEN PayMethod = '#39'CH'#39' THEN Dare ELSE 0 END' +
        '), 0) AS SumCH,'
      
        '    COALESCE(SUM(CASE WHEN PayMethod = '#39'EU'#39' THEN Dare ELSE 0 END' +
        '), 0) AS SumEU,'
      
        '    COALESCE(SUM(CASE WHEN PayMethod = '#39'CC'#39' THEN Dare ELSE 0 END' +
        '), 0) AS SumCC,'
      
        '    COALESCE(SUM(CASE WHEN PayMethod = '#39'RT'#39' THEN Dare ELSE 0 END' +
        '), 0) AS SumRT,'
      
        '    COALESCE(SUM(CASE WHEN PayMethod IN ('#39'CH'#39','#39'EU'#39','#39'CC'#39','#39'RT'#39') TH' +
        'EN Dare ELSE 0 END), 0) AS TotalDirectBarSales,'
      
        '    COUNT(CASE WHEN PayMethod = '#39'ET'#39' THEN 1 END) AS TotalEntryTi' +
        'ckets,'
      '    COALESCE(SUM(CASE WHEN PayMethod IN ('#39'CH'#39','#39'EU'#39','#39'CC'#39','#39'RT'#39')'
      
        '                      AND SoldBy IS NOT NULL AND SoldBy <> 0 AND' +
        ' Dare > 0'
      '                 THEN Dare ELSE 0 END), 0) AS TotalSoldBy'
      'FROM Bar_OpLedger'
      'WHERE Dare > 0'
      '  AND Data BETWEEN CAST('#39'2025-09-01 00:00:00'#39' AS TIMESTAMP) '
      '               AND CAST('#39'2025-09-06 23:59:59'#39' AS TIMESTAMP)'
      'GROUP BY ClosingID, Waiter'
      'ORDER BY ClosingID, Waiter;')
    Params = <>
    Left = 632
    Top = 408
  end
