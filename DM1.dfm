  object qy_RR_All__MayBeNot: TEDBQuery
    ReadOnly = True
    DatabaseName = 'DB_Main'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      'SELECT'
      '    rr.BuildingID,'
      '    build.Name AS Indirizzo,'
      '    ApartmentID as App,'
      '    RoomID AS Stanza,'
      
        '    MAX(rb.SingleOccupancy) AS SingleOccupancy, -- Aggregating S' +
        'ingleOccupancy'
      '    COUNT(BedID) AS Bed_Count, '
      '   COUNT(rb.GuestID) AS Guest_Count,   '
      
        '    MAX(CASE WHEN BedID = 1 THEN c.Alias ELSE NULL END) AS Letto' +
        '_1,'
      
        '    MAX(CASE WHEN BedID = 1 THEN rr.BookingID ELSE NULL END) AS ' +
        'Booking_1,'
      
        '    MAX(CASE WHEN BedID = 1 THEN rb.GuestID ELSE NULL END) AS Gu' +
        'est_1,'
      
        '    MAX(CASE WHEN BedID = 1 THEN rb.CheckInDate ELSE NULL END) A' +
        'S CiD_1,'
      
        '    MAX(CASE WHEN BedID = 1 THEN rb.CheckOutDate ELSE NULL END) ' +
        'AS CoD_1,'
      ''
      
        '    MAX(CASE WHEN BedID = 2 THEN c.Alias ELSE NULL END) AS Letto' +
        '_2,'
      
        '    MAX(CASE WHEN BedID = 2 THEN rr.BookingID ELSE NULL END) AS ' +
        'Booking_2,'
      
        '    MAX(CASE WHEN BedID = 2 THEN rb.GuestID ELSE NULL END) AS Gu' +
        'est_2,'
      
        '    MAX(CASE WHEN BedID = 2 THEN rb.CheckInDate ELSE NULL END) A' +
        'S CiD_2,'
      
        '    MAX(CASE WHEN BedID = 2 THEN rb.CheckOutDate ELSE NULL END) ' +
        'AS CoD_2,'
      ''
      
        '    MAX(CASE WHEN BedID = 3 THEN c.Alias ELSE NULL END) AS Letto' +
        '_3,'
      
        '    MAX(CASE WHEN BedID = 3 THEN rr.BookingID ELSE NULL END) AS ' +
        'Booking_3,'
      
        '    MAX(CASE WHEN BedID = 3 THEN rb.GuestID ELSE NULL END) AS Gu' +
        'est_3,'
      
        '    MAX(CASE WHEN BedID = 3 THEN rb.CheckInDate ELSE NULL END) A' +
        'S CiD_3,'
      
        '    MAX(CASE WHEN BedID = 3 THEN rb.CheckOutDate ELSE NULL END) ' +
        'AS CoD_3,'
      ''
      
        '    MAX(CASE WHEN BedID = 4 THEN c.Alias ELSE NULL END) AS Letto' +
        '_4,'
      
        '    MAX(CASE WHEN BedID = 4 THEN rr.BookingID ELSE NULL END) AS ' +
        'Booking_4,'
      
        '    MAX(CASE WHEN BedID = 4 THEN rb.GuestID ELSE NULL END) AS Gu' +
        'est_4,'
      
        '    MAX(CASE WHEN BedID = 4 THEN rb.CheckInDate ELSE NULL END) A' +
        'S CiD_4,'
      
        '    MAX(CASE WHEN BedID = 4 THEN rb.CheckOutDate ELSE NULL END) ' +
        'AS CoD_4'
      'FROM'
      '    RREU_RentalRooms rr'
      'LEFT JOIN '
      '    RREU_Bookings rb ON rr.BookingID = rb.BookingID'
      'LEFT JOIN '
      '    Clients c ON rb.GuestID = c.ID'
      'LEFT JOIN '
      '    RREU_Buildings build ON rr.BuildingID = build.BuildingID'
      'GROUP BY '
      '    rr.BuildingID, rr.ApartmentID, rr.RoomID, build.Name'
      'ORDER BY '
      '    rr.BuildingID, rr.ApartmentID, rr.RoomID;')
    Params = <>
    Left = 136
    Top = 568
  end
