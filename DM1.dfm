  object qy_RREU_Bookings: TEDBQuery
    ReadOnly = True
    DatabaseName = 'DB_Main'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      
        'SELECT bookingID, cl.Alias,CheckInDate, CheckOutDate, PayedUntil' +
        'Date, RoomRate, supSingleRoom,supShortTerm,SingleOccupancy,'
      'DataDepositIn,DepositAmountPayed,DepositAmountPayMethod'
      'FROM RREU_Bookings b'
      'Left JOIN Clients cl ON cl.ID = b.GuestID')
    Params = <>
    Left = 1016
