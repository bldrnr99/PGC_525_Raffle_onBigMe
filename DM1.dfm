  object qy_LstDays: TEDBQuery
    ReadOnly = True
    DatabaseName = 'DB_Main'
    SessionName = 'PGC_Session_1'
    SQL.Strings = (
      'SELECT c.id, c.Alias,MAX(Data) AS mD FROM ClLedger cl'
      'Left Join Clients c ON cl.ClientID = c.ID'
      'WHERE NOT ID IS NULL'
      'GROUP BY c.ID'
      'Having mD >  CAST('#39'2022-03-03 12:00:00'#39' AS TIMESTAMP)'
      'ORDER BY c.Alias')
    Params = <>
    Left = 136
    Top = 436
  end
