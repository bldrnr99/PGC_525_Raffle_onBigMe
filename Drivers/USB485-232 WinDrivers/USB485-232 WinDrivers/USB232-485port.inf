; Customized FTDIPORT.INF


[Version]
Signature="$Windows NT$"
DriverPackageType=PlugAndPlay
DriverPackageDisplayName=%DESC%
Class=Ports
ClassGUID={4d36e978-e325-11ce-bfc1-08002be10318}
Provider=%FTDI%
CatalogFile=USB232-485port.cat
DriverVer=01/18/2013,2.08.28


[SourceDisksNames]
1=%DriversDisk%,,,

[SourceDisksFiles]
ftser2k.sys=1,i386
ftserui2.dll=1,i386
ftcserco.dll = 1,i386

[SourceDisksFiles.amd64]
ftser2k.sys=1,amd64
ftserui2.dll=1,amd64
ftcserco.dll = 1,amd64

[DestinationDirs]
FtdiPort.NT.Copy=10,system32\drivers
FtdiPort.NT.CopyUI=10,system32
FtdiPort.NT.CopyCoInst=10,system32

[ControlFlags]
ExcludeFromSelect=*

[Manufacturer]
%FTDI%=FtdiHw,NTamd64

[FtdiHw]
%VID_1C40&PID_0475.DeviceDesc%=FtdiPort.NT,FTDIBUS\COMPORT&VID_1C40&PID_0475
%VID_1C40&PID_0476.DeviceDesc%=FtdiPort.NT,FTDIBUS\COMPORT&VID_1C40&PID_0476
%VID_1C40&PID_0477.DeviceDesc%=FtdiPort.NT,FTDIBUS\COMPORT&VID_1C40&PID_0477
%VID_1C40&PID_0478.DeviceDesc%=FtdiPort.NT,FTDIBUS\COMPORT&VID_1C40&PID_0478
%VID_1C40&PID_0479.DeviceDesc%=FtdiPort.NT,FTDIBUS\COMPORT&VID_1C40&PID_0479
%VID_1C40&PID_047A.DeviceDesc%=FtdiPort.NT,FTDIBUS\COMPORT&VID_1C40&PID_047A
%VID_1C40&PID_047B.DeviceDesc%=FtdiPort.NT,FTDIBUS\COMPORT&VID_1C40&PID_047B
%VID_1C40&PID_047C.DeviceDesc%=FtdiPort.NT,FTDIBUS\COMPORT&VID_1C40&PID_047C
%VID_1C40&PID_047E.DeviceDesc%=FtdiPort.NT,FTDIBUS\COMPORT&VID_1C40&PID_047E

[FtdiHw.NTamd64]
%VID_1C40&PID_0475.DeviceDesc%=FtdiPort.NTamd64,FTDIBUS\COMPORT&VID_1C40&PID_0475
%VID_1C40&PID_0476.DeviceDesc%=FtdiPort.NTamd64,FTDIBUS\COMPORT&VID_1C40&PID_0476
%VID_1C40&PID_0477.DeviceDesc%=FtdiPort.NTamd64,FTDIBUS\COMPORT&VID_1C40&PID_0477
%VID_1C40&PID_0478.DeviceDesc%=FtdiPort.NTamd64,FTDIBUS\COMPORT&VID_1C40&PID_0478
%VID_1C40&PID_0479.DeviceDesc%=FtdiPort.NTamd64,FTDIBUS\COMPORT&VID_1C40&PID_0479
%VID_1C40&PID_047A.DeviceDesc%=FtdiPort.NTamd64,FTDIBUS\COMPORT&VID_1C40&PID_047A
%VID_1C40&PID_047B.DeviceDesc%=FtdiPort.NTamd64,FTDIBUS\COMPORT&VID_1C40&PID_047B
%VID_1C40&PID_047C.DeviceDesc%=FtdiPort.NTamd64,FTDIBUS\COMPORT&VID_1C40&PID_047C
%VID_1C40&PID_047E.DeviceDesc%=FtdiPort.NTamd64,FTDIBUS\COMPORT&VID_1C40&PID_047E

[FtdiPort.NT.AddService]
DisplayName    = %SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\system32\drivers\ftser2k.sys
LoadOrderGroup = Base


; -------------- Serenum Driver install section
[SerEnum_AddService]
DisplayName    = %SerEnum.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\serenum.sys
LoadOrderGroup = PNP Filter

[FtdiPort.NT.AddReg]
HKR,,EnumPropPages32,,"ftserui2.dll,SerialPortPropPageProvider"

[FtdiPort.NT.Copy]
ftser2k.sys

[FtdiPort.NT.CopyUI]
ftserui2.dll

[FtdiPort.NT.CopyCoInst]
ftcserco.dll

[FtdiPort.NT]
CopyFiles=FtdiPort.NT.Copy,FtdiPort.NT.CopyUI
AddReg=FtdiPort.NT.AddReg

[FtdiPort.NTamd64]
CopyFiles=FtdiPort.NT.Copy,FtdiPort.NT.CopyUI
AddReg=FtdiPort.NT.AddReg

[FtdiPort.NT.HW]
AddReg=FtdiPort.NT.HW.AddReg

[FtdiPort.NTamd64.HW]
AddReg=FtdiPort.NT.HW.AddReg


[FtdiPort.NT.Services]
AddService = FTSER2K, 0x00000002, FtdiPort.NT.AddService
AddService = Serenum,,SerEnum_AddService
DelService = FTSERIAL

[FtdiPort.NTamd64.Services]
AddService = FTSER2K, 0x00000002, FtdiPort.NT.AddService
AddService = Serenum,,SerEnum_AddService
DelService = FTSERIAL


[FtdiPort.NT.HW.AddReg]
HKR,,"UpperFilters",0x00010000,"serenum"
HKR,,"ConfigData",1,11,00,3F,3F,10,27,00,00,88,13,00,00,C4,09,00,00,E2,04,00,00,71,02,00,00,38,41,00,00,9C,80,00,00,4E,C0,00,00,34,00,00,00,1A,00,00,00,0D,00,00,00,06,40,00,00,03,80,00,00,00,00,00,00,D0,80,00,00
HKR,,"MinReadTimeout",0x00010001,0
HKR,,"MinWriteTimeout",0x00010001,0
HKR,,"LatencyTimer",0x00010001,16


[FtdiPort.NT.CoInstallers]
AddReg=FtdiPort.NT.CoInstallers.AddReg
CopyFiles=FtdiPort.NT.CopyCoInst

[FtdiPort.NTamd64.CoInstallers]
AddReg=FtdiPort.NT.CoInstallers.AddReg
CopyFiles=FtdiPort.NT.CopyCoInst

[FtdiPort.NT.CoInstallers.AddReg]
HKR,,CoInstallers32,0x00010000,"ftcserco.Dll,FTCSERCoInstaller"


;---------------------------------------------------------------;

[Strings]
FTDI="Hjelmslund Electronics"
DESC="CDM Driver Package - VCP Driver"
DriversDisk="USB232-485 Drivers Disk"
PortsClassName = "Ports (COM & LPT)"
VID_1C40&PID_0475.DeviceDesc="USBSER Logic level serial port"
VID_1C40&PID_0476.DeviceDesc="USB485 Isolated port for Modbus"
VID_1C40&PID_0477.DeviceDesc="USB485 Isolated 2 wire port"
VID_1C40&PID_0478.DeviceDesc="USB485 Panel mount port"
VID_1C40&PID_0479.DeviceDesc="USB485 Isolated panel mount port"
VID_1C40&PID_047A.DeviceDesc="USB485 port"
VID_1C40&PID_047B.DeviceDesc="USB232 Isolated panel mount port"
VID_1C40&PID_047C.DeviceDesc="USB485 Isolated 4 wire port"
; Reserved for specials / Fixed baudrates
VID_1C40&PID_047E.DeviceDesc="USB232 Isolated port"
SvcDesc="USB232-485 Port Driver"
SerEnum.SvcDesc="Serenum Filter Driver"

